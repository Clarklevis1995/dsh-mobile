xcuserdata/
*.xcuserstate
*.xccheckout
*.xcscmblueprint

# Xcode build output
DerivedData/
build/
*.ipa
*.dSYM
*.dSYM.zip

# Swift Package Manager local state
.build/
.swiftpm/
Package.resolved
!DeepSeekHarnessMobile.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# Gradle / Android local state
.gradle/
.kotlin/
.idea/
local.properties
*.iml
captures/
.externalNativeBuild/
.cxx/

# 本地生成产物与验证截图
/output/

