.env
.env.*
!.env.example

# iOS 本地真机签名配置
/config/Local.xcconfig

# tsnet 内嵌节点：本地状态与 gomobile 生成产物（不签入，由 :androidApp:buildTsnetAar 生成）
tsnetgo/.state/
tsnetgo/*.aar
tsnetgo/*.sources.jar

# OneTake 本地工程入口，不应提交绝对路径软链接或纳入 Pages 构建。
/promo/onetake-*
